FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags='-s -w' -o /out/chaosreplay-controller ./cmd/chaosreplay-controller

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/chaosreplay-controller /chaosreplay-controller
USER nonroot:nonroot
ENTRYPOINT ["/chaosreplay-controller"]
